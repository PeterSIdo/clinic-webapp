{
  "name": "clinic-consent-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:production": "cross-env EXPO_PUBLIC_ENV_MODE=production EXPO_PUBLIC_API_URL=https://clinic-consent-app-production.up.railway.app/api EXPO_PUBLIC_THERAPIST_EMAIL=clinic@caretrace.uk expo start",
    "start:network": "cross-env EXPO_PUBLIC_ENV_MODE=network EXPO_PUBLIC_API_URL=http://192.168.1.11:3001/api expo start",
    "start:tablet": "cross-env EXPO_PUBLIC_ENV_MODE=network EXPO_PUBLIC_API_URL=http://192.168.1.11:3001/api expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "android:network": "cross-env EXPO_PUBLIC_ENV_MODE=network EXPO_PUBLIC_API_URL=http://192.168.1.11:3001/api expo start --android",
    "ios": "expo start --ios",
    "ios:network": "cross-env EXPO_PUBLIC_ENV_MODE=network EXPO_PUBLIC_API_URL=http://192.168.1.11:3001/api expo start --ios",
    "web": "expo start --web",
    "web:network": "cross-env EXPO_PUBLIC_ENV_MODE=network EXPO_PUBLIC_API_URL=http://192.168.1.11:3001/api expo start --web",
    "build:web": "expo export --platform web",
    "serve:web": "node web-server.js",
    "deploy:web": "npm run build:web && npm run serve:web",
    "test:web:local": "npm run build:web && npm run serve:web",
    "api:dev": "cd api && node server.js",
    "api:test": "node api/test-email-data.json",
    "web:dev": "npm run build:web && npm run serve:web",
    "dev:all": "concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "expo": "~54.0.20",
    "expo-constants": "~18.0.10",
    "expo-file-system": "^19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.13",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-svg": "^15.14.0",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4",
    "npm": ">=10.0.0"
  },
  "private": true
}
