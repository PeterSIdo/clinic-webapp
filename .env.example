# Expo App Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
# For production (Railway deployment)
EXPO_PUBLIC_API_URL=https://clinic-consent-app-production.up.railway.app/api
EXPO_PUBLIC_ENV_MODE=production

# For local development
# EXPO_PUBLIC_API_URL=http://localhost:3001/api
# EXPO_PUBLIC_ENV_MODE=local

# For network mode (tablet connecting to laptop)
# EXPO_PUBLIC_API_URL=http://192.168.1.11:3001/api
# EXPO_PUBLIC_ENV_MODE=network

# Default therapist email
EXPO_PUBLIC_THERAPIST_EMAIL=clinic@caretrace.uk
